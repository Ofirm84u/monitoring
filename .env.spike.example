# PM Hub — Phase 0.5 spike environment (template).
# Copy the values you need into .env.local (auto-loaded by Next) — do NOT commit real secrets.

# --- Local SQLite (spike/dev). On the VM this defaults to /home/ofir/monitor/app.db ---
SQLITE_PATH=./.data/app.db

# --- Auth.js v5 ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3040
# Google OAuth client (Web application). Authorized redirect URI:
#   http://localhost:3040/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Secret-at-rest key (32 bytes hex) for OAuth tokens (NFR-SEC-3) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENC_KEY=

# --- Access control ---
OWNER_EMAIL=ofir.schwartz@gmail.com
ALLOWED_EMAILS=

# --- Bot identity (for the whoami bot-path test; reuse existing BOT_API_TOKEN) ---
# BOT_API_TOKEN is already defined for the existing monitor bot.

# --- Calendar (optional). If unset, a dedicated "PM Hub" calendar is auto-created. ---
# GCAL_CALENDAR_ID=
